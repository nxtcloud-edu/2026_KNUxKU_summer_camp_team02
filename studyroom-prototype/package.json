{
  "name": "studyroom-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe-wasm.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sim": "esbuild scripts/nod-sim.mjs --bundle --platform=node --format=esm --outfile=node_modules/.sim.mjs --log-level=error && node node_modules/.sim.mjs",
    "compare": "esbuild scripts/compare-models.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cmp.mjs --log-level=error && node node_modules/.cmp.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,json,html}\"",
    "check": "npm run format:check && npm run lint && npm run sim && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.15",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  }
}
