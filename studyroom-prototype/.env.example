# ─────────────────────────────────────────────────────────────
#  이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
#  .env 는 커밋되지 않습니다 (.gitignore + .githooks/pre-commit)
#
#  ⚠ 변수 이름에 VITE_ 를 붙이지 마세요.
#     Vite 는 VITE_ 로 시작하는 값만 브라우저 번들에 넣습니다.
#     붙이는 순간 F12 를 열면 키가 그대로 보입니다.
# ─────────────────────────────────────────────────────────────

# ── 모델 키 ──
# Google AI Studio (gemini-3.5-flash-lite). 여러 개를 넣으면 캐릭터별로 나눠 씁니다.
# 캐릭터가 3명이라 3개면 충분하고, 더 넣으면 요약 같은 부가 호출과 예비로 씁니다.
T2=
T3=
T4=
T5=
T6=

# OpenAI (gpt-5.4-mini). 없어도 됩니다 — 없으면 Gemini 만 씁니다.
T1=

# ── 공개 배포용 ──
# 값을 넣으면 /api/* 가 이 열쇠를 요구합니다. 비워 두면 요구하지 않습니다.
# 로컬(127.0.0.1)에서 여는 개발 서버는 열쇠와 무관하게 그냥 동작합니다.
# 팀원에게는 https://주소/?k=열쇠 형태의 링크로 나눠주면 됩니다.
APP_ACCESS_KEY=

# ── 모델 이름 (기본값을 바꾸고 싶을 때만) ──
# MODEL_GEMINI=gemini-3.5-flash-lite
# MODEL_OPENAI=gpt-5.4-mini
